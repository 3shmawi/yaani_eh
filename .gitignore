# Widget Preview related
.widget_preview/

# --- flutter-project-kit ---
# Environment values (only env/example.json is committed)
env/*.json
!env/example.json
# Signing material — never commit
android/key.properties
*.jks
*.keystore
*.p8
*.p12
*.mobileprovision
